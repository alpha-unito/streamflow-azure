{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://streamflow.di.unito.it/schemas/deployment/connector/azure_blob.json",
  "title": "Azure Blob Connector Schema",
  "type": "object",
  "properties": {
    "blob_account_url": {
      "type": "string",
      "description": "URL of the Azure Blob Storage account"
    },
    "action": {
      "type": "string",
      "enum": ["upload", "download", "read"],
      "description": "Action to perform: upload, download or read"
    },
    "container": {
      "type": "string",
      "description": "Name of the blob container"
    },
    "blob_name": {
      "type": "string",
      "description": "Name of the blob object"
    },
    "local_path": {
      "type": "string",
      "description": "Local file path for reading or writing"
    },

    "auth_mode": {
      "type": "string",
      "enum": ["default", "certificate"],
      "description": "Authentication mode: DefaultAzureCredential or certificate-based",
      "default": "default"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant ID for certificate-based authentication"
    },
    "client_id": {
      "type": "string",
      "description": "Client (application) ID for certificate-based authentication"
    },
    "certificate_path": {
      "type": "string",
      "description": "Path to the client certificate file (PEM)"
    },
    "certificate_ca_path": {
      "type": "string",
      "description": "Path to the Ca certificate file"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "auth_mode": { "const": "certificate" } }
      },
      "then": {
        "required": ["tenant_id", "client_id", "certificate_path", "certificate_ca_path"]
      }
    }
  ]
}
